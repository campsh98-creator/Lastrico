# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem
*.key
*.p12
*.jks
*.keystore
*.db
*.sqlite
*.sqlite3
.idea/
.vscode/

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/work/

# Real GPS traces reveal where a person was and must never be committed.
/outputs/field-traces/

# Research: regenerable Phase 4.17 outputs (python experiments/surface-ml/run.py --output <tmp>, then copy back)
/outputs/phase417/map.html
/outputs/phase417/dataset.json.gz
/outputs/phase417/heldout-evaluation.json.gz

# Research: third-party image datasets, model weights and feature caches never enter Git
# (StreetSurfaceVis is CC BY-SA 4.0 and is not redistributed here)
/experiments/*/data/
streetSurfaceVis_*.csv
s_256.zip
s_1024.zip
s_2048.zip
s_original.zip
*.npz
*.npy
*.pt
*.pth
*.ckpt
*.onnx
*.pkl
*.pickle
*.joblib
*.h5
*.hdf5
*.tflite
*.safetensors

# Phase 4.25 benchmark: per-run case outputs and the unpacked provider recordings stay local;
# the summaries are versioned, and the recordings themselves are versioned packed in
# outputs/phase425-benchmark/provider-responses.tar.gz (see PROVIDER_ARCHIVE.md there).
/outputs/phase425-benchmark/*/
# Phase 4.31 reroute benchmark: per-case payloads are derived from that archive; summaries are versioned
/outputs/phase431/reroute-bench/*/cases/

# Rome (Phase 4.23): reproducible byte for byte from data/sources/rome-* with
# scripts/osm/build-rome-pilot.mjs (verified 2026-11-07). Only the packed runtime tiles are versioned.
/data/surfaces/rome-compact-tiles.json
/data/surfaces/rome-tiles/*.json
!/data/surfaces/rome-tiles/metadata.json
